{
  "expo": {
    "name": "Feito!",
    "slug": "feito-app",
    "scheme": "feito",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.feito.prestador"
    },
    "android": {
      "package": "app.feito.prestador",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA580C"
      },
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Feito! usa suas fotos para colocar a logo do seu negócio nos orçamentos.",
          "cameraPermission": "O Feito! usa a câmera para tirar fotos do serviço (antes e depois)."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "icon": "./assets/icon.png"
  }
}